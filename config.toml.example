# Nusa PHP Runtime configuration
#
# Copy to nusa.toml (or pass --config path to the nusa binary).
# Environment variables with prefix NUSA_ override these values.

# PHP execution engine: "child" | "ffi" | "wasm"
# wasm is dev-only unless NUSA_ALLOW_WASM_STUB=1 (CLI exits otherwise)
engine = "child"

# Concurrent request limit / backpressure (must be > 0)
max_workers = 4

# Per-request timeout (milliseconds)
timeout_ms = 30000

# WASM sandbox memory cap (MB); only when engine = "wasm"
wasm_memory_mb = 256

# Virtual filesystem root for PHP scripts
vfs_root = "/app/public"

# Laravel application root (Landlock code_dir)
code_dir = "/app/public"

# Writable temp area (uploads, sessions; Landlock tmp_dir)
tmp_dir = "/tmp/nusa"

# Reload config when this file changes
hot_reload = true

# Octane worker pool size (0 = disabled, Normal mode only via PhpEngine)
octane_workers = 0

# Recycle worker after this resident memory (MB)
octane_max_memory_mb = 512

# Recycle worker after this many handled requests
octane_max_requests = 1000

# HTTP listen address (override with NUSA_BIND)
bind = "0.0.0.0:8080"

# Static files root (empty = {code_dir}/public)
static_root = ""

# --- Experimental (default off) ---

[tls]
enabled = false
acme_email = ""

[redis]
broadcast_url = ""

[quic]
enabled = false
bind = "0.0.0.0:443"
