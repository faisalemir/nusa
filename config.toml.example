# Nusa PHP Runtime — Laravel-friendly example
#
# Plug-and-play options:
#   1. Copy to nusa.toml and edit paths
#   2. Run `nusa init` from your Laravel root
#   3. Container: set NUSA_* env only (no file) — see docs/public/laravel/docker.md
#
# Environment overrides: prefix NUSA_ (env wins over this file).
# Nested keys use double underscore, e.g. NUSA_TLS__ENABLED=true

engine = "child"
max_workers = 4
timeout_ms = 30000

# Laravel application root (where artisan lives) — NOT public/ alone
code_dir = "/app"
vfs_root = "/app/public"
tmp_dir = "/tmp/nusa"

hot_reload = false
octane_workers = 4
octane_backend = "ipc"
octane_max_memory_mb = 512
octane_max_requests = 1000
octane_standby_workers = 1
bind = "0.0.0.0:8080"
static_root = ""
# Tier-S1 Cache-Control max-age (seconds)
static_cache_max_age_secs = 3600
static_cache_immutable_max_age_secs = 31536000
static_cache_max_entries = 1000
static_cache_ttl_secs = 300
# Optional build-time siblings: app.js.br / app.js.gz served when Accept-Encoding matches
# P4-D embed: NUSA_ASYNC_IO=stub, NUSA_EMBED_TRANSPORT=json (to opt out of frame default), optional NUSA_ASYNC_SQLITE_PATH

# Alpine CI: `php` → php85 via symlink; host may use php85 explicitly
php_binary = "php"
# php_bootstrap = "/path/to/bootstrap/nusa-child-ipc.php"

[tls]
enabled = false
acme_email = ""

[redis]
broadcast_url = ""

[quic]
enabled = false
bind = "0.0.0.0:443"

# Optional multi-tenant registry (when non-empty, only listed tenants are allowed)
# [[tenants]]
# id = "acme"
# vfs_root = "/var/tenants/acme/public"
# enabled = true
# max_memory_mb = 512
# max_requests_per_minute = 1000
