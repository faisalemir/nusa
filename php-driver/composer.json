{
    "name": "nusa-rs/octane-driver",
    "description": "Rust-powered Octane driver for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nusa Runtime Team"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "laravel/octane": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "NusaRs\\OctaneDriver\\": "src/"
        }
    },
    "bin": [
        "bin/octane-rust-worker"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "NusaRs\\OctaneDriver\\OctaneRustServiceProvider"
            ]
        }
    }
}