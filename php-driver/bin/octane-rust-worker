#!/usr/bin/env php
<?php
/**
 * Nusa Octane Worker Bridge
 *
 * This binary boots Laravel once and communicates with the Nusa
 * Rust orchestrator via framed IPC over Unix Domain Sockets.
 *
 * Usage: php bin/octane-rust-worker /path/to/worker.sock
 *
 * @package Nusa\Octane
 */

declare(strict_types=1);

use Nusa\Octane\Worker;

$socketPath = $argv[1] ?? null;

if (!$socketPath) {
    fwrite(STDERR, "Usage: php octane-rust-worker <socket-path>\n");
    exit(1);
}

// Nusa spawns this script with cwd = Laravel app root (fixture or deploy tree).
$appRoot = getcwd();
if ($appRoot === false || !is_file($appRoot . '/vendor/autoload.php')) {
    fwrite(STDERR, "Laravel app root not found (cwd must contain vendor/autoload.php)\n");
    exit(1);
}

require_once $appRoot . '/vendor/autoload.php';

// Bootstrap Laravel application
$app = require $appRoot . '/bootstrap/app.php';
$kernel = $app->make(Illuminate\Contracts\Http\Kernel::class);

// Create worker and start IPC loop
$worker = new Worker($socketPath, $kernel);
$worker->run();
